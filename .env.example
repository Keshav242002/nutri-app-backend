# ─────────────────────────────────────────────────────
# NutriPlan Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ─────────────────────────────────────────────────────

# ── Django (M0) ──────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=nutriplan.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (M0) ─────────────────────────────────────
# POSTGRES_PASSWORD is used by docker-compose.yml; change it in production.
POSTGRES_PASSWORD=nutriplan
DATABASE_URL=postgres://nutriplan:nutriplan@localhost:5432/nutriplan

# ── CORS (M0) ─────────────────────────────────────────
# In production, set to your actual Flutter app origin(s)
CORS_ALLOWED_ORIGINS=

# ── Redis / Celery (M6) ───────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Firebase Auth (M1) ────────────────────────────────
# Also used for FCM push notifications (M7.5) — no separate credentials needed.
# Local: path to downloaded service account JSON
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-admin.json
# Production: paste the entire JSON as a single-line string
FIREBASE_CREDENTIALS_JSON=

# ── LLM Provider (M7) ────────────────────────────────
# AI_PROVIDER: openrouter (default/free) | openai | gemini_openai | gemini_native
AI_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=30

# OpenRouter — free tier, no billing required
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_MODEL=openrouter/free

# OpenAI (optional — only if AI_PROVIDER=openai or gemini_openai)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o

# Gemini (optional — only if AI_PROVIDER=gemini_openai or gemini_native)
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# ── USDA FoodData Central (M7) ────────────────────────
USDA_API_KEY=replace-me
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# ── Rate limits (M8) ─────────────────────────────────
REGENERATE_RATE_LIMIT=3/d
CHAT_RATE_LIMIT=30/h

# ── Sentry (M8, optional) ────────────────────────────
SENTRY_DSN=

# ===== DEV-ONLY: DO NOT ENABLE IN PRODUCTION =====
# When True, requests whose Authorization: Bearer token exactly matches
# DEV_AUTH_BYPASS_TOKEN are auto-authenticated as a fixed dev user
# (firebase_uid=dev-bypass-uid-001) WITHOUT calling Firebase.
# Requires DEBUG=True AND DEV_AUTH_BYPASS_ENABLED=True AND exact token match.
# production.py hard-codes this False regardless of the env var.
# NEVER set this to True in any internet-facing deployment.
DEV_AUTH_BYPASS_ENABLED=False
DEV_AUTH_BYPASS_TOKEN=dev-bypass-token-do-not-ship

# ── USDA FoodData Central — seed data fetch (Phase 6) ──
# Also used by M7 at runtime. Get a free key at:
# https://fdc.nal.usda.gov/api-key-signup.html