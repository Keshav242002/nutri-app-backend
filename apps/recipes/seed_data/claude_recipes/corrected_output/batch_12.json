         ],
         "prep_time_min":10,
         "cook_time_min":20,
         "servings":4,
         "estimated_difficulty":"beginner",
         "spice_level":"mild",
         "ingredients":[
            {
               "ingredient_name":"toor_dal_raw",
               "quantity_grams":150.0,
               "display_quantity":0.75,
               "display_unit":"cup",
               "notes":"washed and soaked for 20 mins"
            },
            {
               "ingredient_name":"turmeric_powder_raw",
               "quantity_grams":2.0,
               "display_quantity":0.5,
               "display_unit":"tsp",
               "notes":""
            },
            {
               "ingredient_name":"asafoetida_raw",
               "quantity_grams":1.0,
               "display_quantity":0.25,
               "display_unit":"tsp",
               "notes":"hing - a generous pinch"
            },
            {
               "ingredient_name":"salt_raw",
               "quantity_grams":5.0,
               "display_quantity":1.0,
               "display_unit":"tsp",
               "notes":"to taste"
            },
            {
               "ingredient_name":"jaggery_raw",
               "quantity_grams":10.0,
               "display_quantity":2.0,
               "display_unit":"tsp",
               "notes":"crushed, optional for slight sweetness (Goda Varan)"
            },
            {
               "ingredient_name":"ghee_raw",
               "quantity_grams":14.0,
               "display_quantity":1.0,
               "display_unit":"tbsp",
               "notes":"for tempering and serving"
            },
            {
               "ingredient_name":"cumin_raw",
               "quantity_grams":2.0,
               "display_quantity":1.0,
               "display_unit":"tsp",
               "notes":""
            },
            {
               "ingredient_name":"curry_leaves_raw",
               "quantity_grams":2.0,
               "display_quantity":2.0,
               "display_unit":"g",
               "notes":"1 sprig"
            },
            {
               "ingredient_name":"coriander_leaves_raw",
               "quantity_grams":5.0,
               "display_quantity":2.0,
               "display_unit":"tbsp",
               "notes":"finely chopped for garnish"
            }
         ],
         "instructions":[
            "In a pressure cooker, add the washed toor dal, turmeric powder, a few drops of ghee, and 2 cups of water.",
            "Pressure cook for 4-5 whistles on medium heat until the dal is completely soft and mushy.",
            "Let the pressure release naturally. Open the cooker and whisk the dal well until perfectly smooth.",
            "Add the salt, crushed jaggery, and an extra half cup of water to adjust the consistency. Bring to a gentle simmer for 3 minutes.",
            "In a small tempering pan, heat the remaining ghee. Add cumin seeds and let them splutter.",
            "Add asafoetida and curry leaves to the hot ghee, letting them sizzle for 5 seconds.",
            "Pour this hot tempering over the simmering dal. Turn off the heat.",
            "Garnish with freshly chopped coriander leaves and serve hot with steamed rice (Varan-Bhat)."
         ]
