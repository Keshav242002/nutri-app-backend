      {
         "name":"Maharashtrian Sadha Varan",
         "name_alt":"Simple Toor Dal",
         "meal_type":"dinner",
         "cuisine":"maharashtrian",
         "diet_tags":[
            "vegetarian",
            "gluten_free",
