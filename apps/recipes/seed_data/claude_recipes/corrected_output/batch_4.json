         "spice_level":"medium",
         "ingredients":[
            {
               "ingredient_name":"basmati_rice_raw",
               "quantity_grams":120.0,
               "display_quantity":1.0,
               "display_unit":"katori",
               "notes":"raw rice"
            },
            {
               "ingredient_name":"potato_raw",
               "quantity_grams":150.0,
               "display_quantity":1.0,
               "display_unit":"piece",
               "notes":"whole, peeled"
            },
            {
               "ingredient_name":"onion_raw",
               "quantity_grams":30.0,
               "display_quantity":3.0,
               "display_unit":"tbsp",
               "notes":"finely chopped"
            },
            {
               "ingredient_name":"green_chilli_raw",
               "quantity_grams":5.0,
               "display_quantity":1.0,
               "display_unit":"piece",
               "notes":"finely chopped"
            },
            {
               "ingredient_name":"mustard_oil_raw",
               "quantity_grams":10.0,
               "display_quantity":2.0,
               "display_unit":"tsp",
               "notes":"raw, drizzled over mash"
            },
            {
               "ingredient_name":"salt_raw",
               "quantity_grams":3.0,
               "display_quantity":0.5,
               "display_unit":"tsp",
               "notes":"to taste"
            }
         ],
         "instructions":[
            "Wash the basmati rice in clean water until the water runs clear; drain.",
            "Peel the raw potato and keep it whole so it cooks alongside the rice without disintegrating.",
            "In a deep pot, combine the drained rice, the whole potato and about three cups of water.",
            "Place over medium-high heat and bring to a boil; then lower the heat, cover, and cook for fifteen minutes until rice is done and potato is fork-tender.",
            "Scoop the boiled potato out of the rice and transfer to a mixing bowl.",
