    {
      "name": "Steamed Sona Masoori Rice",
      "name_alt": "Annam",
      "meal_type": "dinner",
      "cuisine": "south_indian",
      "diet_tags": [
        "vegetarian",
        "gluten_free",
        "nut_free"
      ],
      "allergen_tags": [
        "dairy"
      ],
      "prep_time_min": 15,
      "cook_time_min": 20,
      "servings": 4,
      "estimated_difficulty": "beginner",
      "spice_level": "mild",
      "ingredients": [
        {
          "ingredient_name": "sona masoori rice",
          "quantity_grams": 200.0,
          "display_quantity": 1.0,
          "display_unit": "cup",
          "notes": "washed and soaked for 15 minutes"
        },
        {
          "ingredient_name": "salt",
          "quantity_grams": 3.0,
          "display_quantity": 0.5,
          "display_unit": "tsp",
          "notes": "optional"
        },
        {
          "ingredient_name": "ghee",
          "quantity_grams": 7.0,
          "display_quantity": 0.5,
          "display_unit": "tbsp",
          "notes": "to drizzle on top"
        }
      ],
      "instructions": [
        "Wash the sona masoori rice thoroughly under running water until the water runs clear.",
        "Soak the washed rice in freshwater for 15 minutes to ensure softer grains, then drain.",
        "In a heavy-bottomed pot, bring 2.5 cups of water to a boil along with the salt.",
        "Add the drained rice to the boiling water. Stir once, cover with a tight-fitting lid, and lower the heat to the minimum setting.",
        "Cook undisturbed for 15-18 minutes until all the water is absorbed and the grains are tender.",
        "Turn off the heat, let it rest for 5 minutes, then fluff gently. Drizzle with ghee before serving with rasam or sambar."
      ]
    },
    {
      "name": "Simple Dosa",
      "name_alt": "Sada Dosa",
      "meal_type": "dinner",
      "cuisine": "south_indian",
      "diet_tags": [
        "vegan",
        "vegetarian",
        "dairy_free",
        "gluten_free",
        "nut_free"
      ],
      "allergen_tags": [
        "sesame"
      ],
      "prep_time_min": 20,
      "cook_time_min": 20,
      "servings": 4,
      "estimated_difficulty": "advanced",
      "spice_level": "mild",
      "ingredients": [
        {
          "ingredient_name": "parboiled rice",
          "quantity_grams": 200.0,
          "display_quantity": 1.0,
          "display_unit": "cup",
          "notes": "soaked for 6 hours"
        },
        {
          "ingredient_name": "urad dal",
          "quantity_grams": 60.0,
          "display_quantity": 0.3,
          "display_unit": "cup",
          "notes": "soaked for 6 hours"
        },
        {
          "ingredient_name": "fenugreek seeds",
          "quantity_grams": 2.0,
          "display_quantity": 0.5,
          "display_unit": "tsp",
          "notes": "soaked with the dal"
        },
        {
          "ingredient_name": "salt",
          "quantity_grams": 6.0,
          "display_quantity": 1.0,
          "display_unit": "tsp",
          "notes": ""
        },
        {
          "ingredient_name": "sesame oil",
          "quantity_grams": 28.0,
          "display_quantity": 2.0,
          "display_unit": "tbsp",
          "notes": "for roasting dosas"
        }
      ],
      "instructions": [
        "Wash and soak the parboiled rice in one bowl, and the urad dal along with fenugreek seeds in another bowl, for 6-8 hours.",
        "Drain the water. Grind the urad dal mixture in a blender until extremely smooth and fluffy, adding a little ice water as needed.",
        "Transfer to a large vessel. Next, grind the soaked rice until it reaches a slightly grainy, smooth consistency.",
        "Mix the rice batter into the dal batter, add salt, and mix vigorously with clean hands to aerate.",
        "Cover and leave in a warm place to ferment for 8-10 hours until the batter has risen and is bubbly.",
        "When ready to cook, heat a cast-iron tawa (griddle) on medium-high heat. Stir the batter well.",
        "Pour a ladle full of batter in the center of the tawa and spread it outward in quick circular motions to make a thin crepe.",
        "Drizzle half a teaspoon of sesame oil around the edges. Cook until the bottom turns golden brown and crisp, then fold and serve hot."
      ]
    },
