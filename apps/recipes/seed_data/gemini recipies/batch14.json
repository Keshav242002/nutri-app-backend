          "ingredient_name": "turmeric powder",
          "quantity_grams": 3.0,
          "display_quantity": 0.5,
          "display_unit": "tsp",
          "notes": "divided use"
        },
        {
          "ingredient_name": "red chilli powder",
          "quantity_grams": 5.0,
          "display_quantity": 1.5,
          "display_unit": "tsp",
          "notes": "divided use"
        },
        {
          "ingredient_name": "cumin",
          "quantity_grams": 2.0,
          "display_quantity": 1.0,
          "display_unit": "tsp",
          "notes": ""
